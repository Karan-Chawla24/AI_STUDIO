{
  "name": "educational-video-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run typecheck && npm run lint",
    "test:db": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/db.test.ts",
    "test:auth": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/auth.test.ts",
    "test:email": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/account-email.test.ts",
    "email:preview": "node --import tsx scripts/email-preview.ts",
    "test:projects": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/projects.test.ts",
    "test:library": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/library.test.ts",
    "library:migrate": "node --conditions=react-server --import tsx scripts/library-db.ts migrate",
    "library:verify": "node --conditions=react-server --import tsx scripts/library-db.ts verify",
    "projects:migrate": "node --conditions=react-server --import tsx scripts/projects-db.ts migrate",
    "projects:verify": "node --conditions=react-server --import tsx scripts/projects-db.ts verify",
    "auth:migrate": "node --conditions=react-server --import tsx scripts/auth-db.ts migrate",
    "auth:verify": "node --conditions=react-server --import tsx scripts/auth-db.ts verify",
    "auth:schema": "node --conditions=react-server --import tsx scripts/auth-db.ts schema",
    "db:check": "node --conditions=react-server --import tsx scripts/db.ts check",
    "db:status": "node --conditions=react-server --import tsx scripts/db.ts status",
    "db:migrate": "node --conditions=react-server --import tsx scripts/db.ts migrate",
    "db:verify": "node --conditions=react-server --import tsx scripts/db.ts verify"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.12",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@next/env": "16.4.2",
    "better-auth": "1.7.12",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.2",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3"
  }
}
