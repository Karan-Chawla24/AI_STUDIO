# Copy to .env.local for database commands. Never commit credentials.
# The UI scaffold/build still works without database configuration.
# Use an Atlas URI or a local replica set (a standalone server is insufficient).
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=educational_video_dev

# Exact browser origin; use this same hostname and port when testing.
APP_ORIGIN=http://localhost:3001
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Local testing writes private messages to studio/.local/emails (never public/).
# For real delivery select resend and configure a verified sender.
EMAIL_DELIVERY=preview
RESEND_API_KEY=
EMAIL_FROM=

# Optional cursor signing key; blank uses the auth secret with a separate HMAC domain.
PROJECT_CURSOR_SECRET=
# Previous signing key during a 30-minute rotation grace period.
PROJECT_CURSOR_PREVIOUS_SECRET=

# F09 server-only planner. Use an enabled Gemini model; no automatic fallback.
GEMINI_API_KEY=
GEMINI_MODEL=
